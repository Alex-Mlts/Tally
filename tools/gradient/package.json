{
  "name": "tally-gradient-build",
  "private": true,
  "description": "Builds public/vendor/shadergradient.js for the landing page. Only needed to change the gradient; the built file is already included.",
  "scripts": { "build": "esbuild entry.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../../public/vendor/shadergradient.js" },
  "dependencies": {
    "@shadergradient/react": "2.4.20",
    "@react-three/fiber": "^8.17.10",
    "three": "^0.170.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": { "esbuild": "^0.24.0" }
}
